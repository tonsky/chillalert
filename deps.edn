{:paths ["src"]
 :deps
 {org.clojure/clojure                {:mvn/version "1.12.6"}
  io.github.tonsky/clojure-plus      {:mvn/version "1.7.2"}
  mount/mount                        {:mvn/version "0.1.24"}
  http-kit/http-kit                  {:mvn/version "2.8.1"}
  ring/ring-core                     {:mvn/version "1.15.5"}
  io.github.tonsky/clj-simple-router {:mvn/version "0.1.2"}
  hiccup/hiccup                      {:mvn/version "2.0.0"}
  cheshire/cheshire                  {:mvn/version "6.2.0"}
  com.github.seancorfield/next.jdbc  {:mvn/version "1.3.1118"}
  org.xerial/sqlite-jdbc             {:mvn/version "3.53.4.0"}}
 :aliases
 {:package
  {:extra-paths ["package"]
   :extra-deps  {uberdeps/uberdeps {:mvn/version "1.4.0"}}}

  :dev
  {:extra-paths ["dev" "test"]
   :extra-deps
   {io.github.tonsky/clj-reload {:mvn/version "1.0.0"}
    ring/ring-devel             {:mvn/version "1.15.5"}
    ring-refresh/ring-refresh   {:mvn/version "0.2.0"}}
   :jvm-opts ["-ea"
              "-Djdk.attach.allowAttachSelf"
              "-XX:+UnlockDiagnosticVMOptions"
              "-XX:+DebugNonSafepoints"
              "-XX:+EnableDynamicAgentLoading"]}}}
